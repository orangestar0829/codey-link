# 环境变量 > 项目根目录 .env > 默认值。修改后重启专用 daemon。
# 以下大小单位均为 MiB；设为 0 可禁止对应自动预览。
CODEY_LINK_IMAGE_MAX_MIB=10
CODEY_LINK_MESSAGE_IMAGES_MAX_MIB=20
CODEY_LINK_MESSAGE_IMAGES_MAX_COUNT=8

# 每次历史加载从最新消息向前分配的自动预览预算。
CODEY_LINK_IMAGE_AUTOLOAD_MAX_COUNT=8
CODEY_LINK_IMAGE_AUTOLOAD_MAX_MIB=20

# 缩略图画布宽度、高度上限和 JPEG 质量；图片等比居中、不裁剪。
# 实际高度不超过宽度；默认 2:1 横向框，避免手机竖长图撑满屏幕。
# 单张生成结果硬上限为 256 KiB。
CODEY_LINK_IMAGE_THUMBNAIL_EDGE=480
CODEY_LINK_IMAGE_THUMBNAIL_HEIGHT=240
CODEY_LINK_IMAGE_THUMBNAIL_QUALITY=70

# 手机图片插件：点击后读取原图的上限，范围 1–1024 MiB；不影响旧 App 的文件入口。
CODEY_LINK_IMAGE_OPEN_MAX_MIB=20

# 桥接元数据检查与缩略图生成的并发数；App 的下载并发由 App 控制。
CODEY_LINK_IMAGE_PREPARE_CONCURRENCY=2
